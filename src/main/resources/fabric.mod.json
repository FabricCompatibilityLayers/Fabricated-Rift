{
  "schemaVersion": 1,
  "id": "fabricated-rift",
  "version": "${version}",
  "name": "Fabricated Rift",
  "description": "Rift ModLoader as a FabricLoader mod.",
  "authors": [
    "Cat Core"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/fabricated-rift",
    "sources": "https://github.com/FabricCompatibilityLayers/Fabricated-Rift"
  },
  "license": "MIT",
  "icon": "assets/fabricated-rift/icon.png",
  "environment": "*",
  "entrypoints": {
    "mod-remapper-api:modremapper_v2": [
      "io.github.fabriccompatibilitylayers.fabricatedrift.FabricatedRift"
    ],
    "preLaunch": [
      "io.github.fabriccompatibilitylayers.fabricatedrift.FabricatedRiftPreLaunch"
    ],
    "modmenu": [
      "io.github.fabriccompatibilitylayers.fabricatedrift.modmenu.FabricatedRiftModMenuCompat"
    ]
  },
  "mixins": [
    "mixins.rift.core.json",
    "mixins.rift.hooks.json",
    "mixins.fabricated-rift.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.10",
    "minecraft": "${mc_version}",
    "mod-remapping-api": ">=${mrapi_version}"
  },
  "accessWidener": "fabricated-rift.accesswidener"
}
